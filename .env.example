# Cloudflare Credentials (Set in GitHub Secrets)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Resource IDs (Set in GitHub Secrets or Variables)
KV_NAMESPACE_ID=your_kv_namespace_id_here
ANALYTICS_DATASET=LINK_REDIRECT_ANALYTICS

# Application Configurations (Set in GitHub Secrets or Variables)
WORKER_NAME=cf-link-redirect
CUSTOM_DOMAIN=go.yourdomain.com
ADMIN_TOKEN=your_secret_bearer_token_here
DEFAULT_FALLBACK_URL=https://twitter.com/your_handle
SITE_NAME="Link Redirect Gateway"
